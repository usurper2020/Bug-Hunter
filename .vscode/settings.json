{
    "CodeGPT.apiKey": "CodeGPT Plus Beta",
    "todo-tree.tree.showBadges": true,
    "todo-tree.tree.scanMode": "open files",
    "git.ignoreLimitWarning": true,
    "inlineChat.finishOnType": true,
    "inlineChat.lineEmptyHint": true,
    "cSpell.words": [
        "aiohttp",
        "asyncio",
        "barpolar",
        "bugbounty",
        "collab",
        "cupy",
        "cython",
        "dateutil",
        "faiss",
        "fastapi",
        "httpx",
        "isort",
        "keras",
        "KHTML",
        "loguru",
        "mkdocs",
        "mypy",
        "nltk",
        "numpy",
        "onupdate",
        "psycopg",
        "pydantic",
        "pydocstyle",
        "pyjwt",
        "pylint",
        "pyqt",
        "pytest",
        "pytz",
        "pyyaml",
        "qasync",
        "qtawesome",
        "qtpng",
        "qtpy",
        "scikit",
        "socketio",
        "spacy",
        "sqlalchemy",
        "starlette",
        "Tfidf",
        "tickformatstops",
        "tqdm",
        "uvicorn",
        "Vectorizer",
        "viewstate",
        "waybackpy"
    ],
    "docwriter.style": "NumPy",
    "docwriter.progress.trackMethods": true,
    "docwriter.progress.trackClasses": true,
    "docwriter.progress.trackTypes": true,
    "docwriter.progress.trackFunctions": true,
    "docwriter.progress.trackModules": true,
    "docwriter.progress.trackPackages": true,
    "docwriter.progress.trackAttributes": true,
    "docwriter.progress.trackVariables": true,
    "docwriter.progress.trackConstants": true,
    "python.pythonPath": "C:/path/to/your/python.exe",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.autoSave": "onFocusChange",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": true,
    "python.linting.flake8Enabled": true,
    "python.linting.pylintArgs": [
        "--disable=C0111" // Disable missing docstring warning
    ],
    "python.formatting.provider": "black",
    "terminal.integrated.cwd": "${workspaceFolder}",
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    "search.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    "gitlab.instanceUrl": "https://gitlab.com",
    "gitlab.token": "your_personal_access_token",
    "markdownlint.config": {
        "MD013": false
    },
    "pgsql.applyLocalization": true,
    "pgsql.copyIncludeHeaders": true,
    "pgsql.format.alignColumnDefinitionsInColumns": true,
    "pgsql.enableStartupDebugging": true,
    "pgsql.format.placeSelectStatementReferencesOnNewLine": true,
    "docwriter.language": "English"
}