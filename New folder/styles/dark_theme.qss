/* Dark theme stylesheet for BugHunter */

/* Global styles */
QWidget {
    background-color: #2b2b2b;
    color: #ffffff;
    font-family: "Segoe UI", Arial, sans-serif;
}

/* Main window */
QMainWindow {
    background-color: #1e1e1e;
}

/* Menu bar */
QMenuBar {
    background-color: #333333;
    color: #ffffff;
}

QMenuBar::item:selected {
    background-color: #404040;
}

/* Push buttons */
QPushButton {
    background-color: #0d47a1;
    border: none;
    color: white;
    padding: 5px 15px;
    border-radius: 3px;
}

QPushButton:hover {
    background-color: #1565c0;
}

QPushButton:pressed {
    background-color: #0a3d91;
}

/* Text inputs */
QLineEdit, QTextEdit {
    background-color: #3c3c3c;
    border: 1px solid #555555;
    color: #ffffff;
    padding: 5px;
    border-radius: 3px;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #0d47a1;
}

/* List and tree views */
QTreeView, QListView, QTableView {
    background-color: #2d2d2d;
    alternate-background-color: #353535;
    color: #ffffff;
    border: 1px solid #3c3c3c;
}

QTreeView::item:selected, QListView::item:selected, QTableView::item:selected {
    background-color: #0d47a1;
}

/* Scroll bars */
QScrollBar:vertical {
    border: none;
    background-color: #2b2b2b;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #404040;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a4a4a;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #3c3c3c;
}

QTabBar::tab {
    background-color: #2b2b2b;
    color: #ffffff;
    padding: 8px 12px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #0d47a1;
}

QTabBar::tab:hover:!selected {
    background-color: #353535;
}

/* Tool tips */
QToolTip {
    background-color: #2b2b2b;
    color: #ffffff;
    border: 1px solid #3c3c3c;
    padding: 5px;
}

/* Status bar */
QStatusBar {
    background-color: #333333;
    color: #ffffff;
}

/* Group boxes */
QGroupBox {
    border: 1px solid #3c3c3c;
    margin-top: 1em;
    padding-top: 0.5em;
}

QGroupBox::title {
    color: #ffffff;
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 3px 0 3px;
}

/* Combo boxes */
QComboBox {
    background-color: #3c3c3c;
    border: 1px solid #555555;
    border-radius: 3px;
    color: #ffffff;
    padding: 5px;
}

QComboBox::drop-down {
    border: none;
}

QComboBox::down-arrow {
    image: url(assets/icons/down_arrow.png);
    width: 12px;
    height: 12px;
}

/* Progress bars */
QProgressBar {
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #0d47a1;
}
